# Copy to .env and fill in. Never commit .env. Variables from SPEC.md section 5.

# Providers tried in this order; use "mock" for tests
LLM_PROVIDER_ORDER=gemini,nvidia
# Gemini key from Google AI Studio (server only)
GEMINI_API_KEY=
# Free Gemini model ID copied from AI Studio
GEMINI_MODEL=
# Gemini requests per minute (kept below the free limit)
GEMINI_RPM=8
# Gemini requests allowed per day before falling back
GEMINI_RPD_BUDGET=200
# NVIDIA key from build.nvidia.com (server only)
NVIDIA_API_KEY=
# Instruct model ID copied from build.nvidia.com
NVIDIA_MODEL=
# NVIDIA OpenAI-compatible base URL
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA requests per minute (kept below the free limit)
NVIDIA_RPM=20
# NVIDIA requests allowed per day before falling back (not in SPEC section 5; A55)
NVIDIA_RPD_BUDGET=200
# Largest output NVIDIA is asked for; bigger calls skip it, and a failed analysis is read again
# in parts that fit (not in SPEC section 5; A95). Any <NAME>_MAX_OUTPUT_TOKENS works the same way.
NVIDIA_MAX_OUTPUT_TOKENS=3072
# Max input tokens per call, estimated as characters / 4
MAX_INPUT_TOKENS=24000
# Max LLM calls in flight across the whole server
LLM_CONCURRENCY=2
# Per-call timeout in milliseconds
LLM_TIMEOUT_MS=45000
# Total time budget for one analysis in milliseconds
ANALYSIS_BUDGET_MS=100000
# Analyses allowed per IP address per 10 minutes
IP_ANALYSES_PER_10_MIN=6
# Analyses allowed across the whole server per day
GLOBAL_ANALYSES_PER_DAY=60

# Not in SPEC section 5 (ASSUMPTIONS A19)
# Port the server listens on; the Vite dev proxy targets it too
PORT=3000
# Base URL that npm run smoke checks
SMOKE_URL=http://localhost:3000

# Not in SPEC section 5 (ASSUMPTIONS A55)
# Gemini REST base URL; change only if Google moves the API version
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Gemini 3 and later: generationConfig.thinkingConfig.thinkingLevel (MINIMAL, LOW, MEDIUM, HIGH); leave empty for Gemini 2.x (A92)
GEMINI_THINKING_LEVEL=LOW
# Mock provider scenario when LLM_PROVIDER_ORDER includes mock (SPEC section 12 list)
MOCK_SCENARIO=normal
# Any extra OpenAI-compatible endpoint: add its name to LLM_PROVIDER_ORDER, then
# set <NAME>_API_KEY, <NAME>_MODEL, <NAME>_BASE_URL and optionally <NAME>_RPM, <NAME>_RPD_BUDGET

# Not in SPEC section 5 (ASSUMPTIONS A90)
# Proxy hops in front of the server whose X-Forwarded-For is trusted for the per-IP limit (0 = none)
TRUST_PROXY=0
