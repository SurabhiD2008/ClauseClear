    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "multer": "2.5.0",
    "pdfjs-dist": "6.4.299",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1"
  }
}
